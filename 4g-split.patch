+class LimitedServerTest {
+    private fun server(name: String, pool: String? = null) = Server(id = name, name = name, protocol = "vless", pool = pool)
+
+    @kotlin.test.Test
+    fun fourGRoutesAreRecognisedByNameOrPool() {
+        kotlin.test.assertTrue(server("🇩🇪 Германия (Ограничен. 4G)").isLimited)
+        kotlin.test.assertTrue(server("Германия 4g").isLimited)
+        kotlin.test.assertTrue(server("Германия (Ограничен.)").isLimited)
+        kotlin.test.assertTrue(server("Любое имя", pool = POOL_WL).isLimited)
+        kotlin.test.assertFalse(server("Германия (Vision)").isLimited)
+        kotlin.test.assertFalse(server("Швеция (XHTTP)").isLimited)
+    }
+}
